# ============== 圈圈语音社 环境变量配置 ==============
# 修改后需重启后端生效。请勿将此文件提交到代码仓库。

# ---- 数据库 ----
# DATABASE_URL=sqlite:///./backend/circle_voice.db

# ---- Token / 管理员 ----
# TOKEN_SECRET=your_secret_change_me
# 管理员账号（登录后台用）
ADMIN_USERNAME=admin
# 管理员密码（启动时加盐哈希，内存中不保留明文）
ADMIN_PASSWORD=CircleVoice@2026
# 管理员 token 有效期（小时），默认 2 小时
ADMIN_TOKEN_EXPIRE_HOURS=2

# ---- CORS ----
# 允许跨域的域名，多个用逗号分隔
# CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# ============== 支付配置（微信支付 V3 / 支付宝） ==============
# 设为 true 启用真实支付；未配置凭证时不会扣款，前端提示"支付未配置"
PAY_ENABLED=true

# 回调公网地址（必须是公网可访问的 HTTPS 域名，微信/支付宝会 POST 到这里）
# 本地调试可用内网穿透（如 ngrok / cpolar）映射到 127.0.0.1:8000
PAY_NOTIFY_BASE=https://your-domain.com

# ---- 微信支付 V3 ----
WX_APPID=
WX_MCHID=
WX_API_V3_KEY=
WX_SERIAL_NO=
# 商户 API 证书私钥（PEM 文本，含 BEGIN/END 行，用双引号包裹，换行用 \n）
WX_PRIVATE_KEY=""

# ---- 支付宝 ----
ALI_APPID=
# 应用私钥（PEM 文本，双引号包裹，换行用 \n）
ALI_PRIVATE_KEY=""
# 支付宝公钥（PEM 文本，双引号包裹，换行用 \n）
ALI_PUBLIC_KEY=""
# 沙箱环境时取消下一行注释
# ALI_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
