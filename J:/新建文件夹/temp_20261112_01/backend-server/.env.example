# =============================================================
# 圈圈语音社 环境变量配置模板
# 复制为 .env 并填入实际值：cp .env.example .env
# =============================================================

# ---------- 安全配置（必填，生产环境务必修改）----------
# Token 签名密钥，随机字符串至少 32 位
TOKEN_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# 管理员密码（后台登录用）
ADMIN_PASSWORD=change_me_strong_password

# CORS 允许的域名（多个用逗号分隔）
# 同域部署可填你的域名，开发用 http://localhost:8000
CORS_ORIGINS=https://your-domain.com

# ---------- 数据库（可选，默认 SQLite）----------
# SQLite（默认，无需配置）
# DATABASE_URL=sqlite:///./circle_voice.db
# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/circle_voice
# MySQL 示例
# DATABASE_URL=mysql://user:password@localhost:3306/circle_voice

# ---------- 支付配置（可选，默认禁用）----------
# 是否启用支付
PAY_ENABLED=false
# 支付回调基础地址
PAY_NOTIFY_BASE=https://your-domain.com

# 微信支付
WX_APPID=
WX_MCHID=
WX_API_V3_KEY=
WX_SERIAL_NO=
WX_PRIVATE_KEY=

# 支付宝
ALI_APPID=
ALI_PRIVATE_KEY=
ALI_PUBLIC_KEY=

# ---------- 其他 ----------
# 管理员 Token 过期时间（小时）
ADMIN_TOKEN_EXPIRE_HOURS=2
